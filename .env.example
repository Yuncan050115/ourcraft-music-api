# Copy to .env.local and fill in only what you need. Never commit real values.

# Server-side NetEase cookie (MUSIC_U=...). Enables VIP track resolution for every
# caller, so treat it as a secret. Leave empty for free-only playback.
# NCM_COOKIE=MUSIC_U=xxxxxxxx
NCM_COOKIE=

# Comma-separated Referer/Origin allowlist. Empty = allow all callers.
# ALLOWLIST=mcyc.top,bgp.strynir.cloud,yuncan.xyz
ALLOWLIST=

# Password for GET /admin. Empty = admin endpoint disabled.
ADMIN_PASSWORD=

ADAPTER_PORT=3017
PLAYLIST_LIMIT=100
URL_STRATEGY=302
DEBUG_RESPONSE=0
